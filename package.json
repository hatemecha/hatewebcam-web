{
  "name": "hatewebcam-web",
  "version": "0.1.0",
  "private": true,
  "description": "Webcam y editor de video local con filtros, detectores y exportación en el navegador.",
  "license": "MIT",
  "author": "Alex Romero (hatemecha)",
  "homepage": "https://hatemecha.github.io/hatewebcam-web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatemecha/hatewebcam-web.git"
  },
  "bugs": {
    "url": "https://github.com/hatemecha/hatewebcam-web/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-templates.mjs",
    "preview": "vite preview",
    "test": "node tests/smoke-check.mjs && node tests/unit-check.mjs && node tests/visual-fx-check.mjs",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1"
  }
